{
  "name": "aether-craft-launcher",
  "version": "8.0.0",
  "description": "Aether Craft v8.0 - Ultimate Minecraft Launcher (Modrinth Store, 1-Click FPS Boost, 3D Cape/Skin Wardrobe, Quick Join Server)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "keywords": ["minecraft", "launcher", "modrinth", "fabric", "forge", "quilt"],
  "author": "buiduchuy2010qn-prog",
  "license": "MIT",
  "dependencies": {
    "minecraft-launcher-core": "^3.16.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.buiduchuy.aethercraft",
    "productName": "AetherCraft",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minecraft Launcher (Aether Craft)",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}