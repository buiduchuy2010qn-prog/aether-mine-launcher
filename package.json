{
  "name": "aether-craft-launcher",
  "version": "30.8.2",
  "description": "Aether Craft v30.8 PRO - Aether Cloud ID 24/7 Internet Database Account System + Strict Microsoft License + Offline",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "modrinth",
    "fabric",
    "forge",
    "quilt"
  ],
  "author": "buiduchuy2010qn-prog",
  "license": "MIT",
  "dependencies": {
    "minecraft-launcher-core": "^3.16.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.buiduchuy.aethercraft",
    "productName": "AetherCraft",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE.rtf"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/ui/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "unicode": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.rtf",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minecraft Launcher (Aether Craft)",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
