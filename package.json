{
  "name": "aether-craft-launcher",
  "version": "7.0.0",
  "description": "Aether Craft v7.0 — Clean Direct Core & Version Selector Minecraft Launcher (No Clutter, 3D WebGL, Smooth-Exit)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "author": "buiduchuy2010qn-prog",
  "license": "MIT",
  "dependencies": {
    "minecraft-launcher-core": "^3.17.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aethercraft.launcher",
    "productName": "AetherCraft",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aether Craft Launcher",
      "runAfterFinish": true,
      "artifactName": "AetherCraft-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "AetherCraft-Portable-${version}.exe"
    }
  }
}