{
  "name": "aether-craft-launcher",
  "version": "26.1.0",
  "description": "Aether Craft v26.1 PRO - Java 21 JVM Fix & Real 3D Pixel Minecraft Grass Block",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "keywords": ["minecraft", "launcher", "modrinth", "fabric", "forge", "quilt"],
  "author": "buiduchuy2010qn-prog",
  "license": "MIT",
  "dependencies": {
    "minecraft-launcher-core": "^3.16.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.buiduchuy.aethercraft",
    "productName": "AetherCraft",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE.rtf"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false, "unicode": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.rtf",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minecraft Launcher (Aether Craft)",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}