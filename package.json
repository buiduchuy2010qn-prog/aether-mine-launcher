{
  "name": "blockway-launcher",
  "version": "41.2.0",
  "description": "BlockWay Launcher v41.2.0 PRO — Every World, One Place (🖥️ Trạm Server Ngầm 0% GPU & Tư Vấn Cấu Hình, 🎨 Kho Làm Đẹp Không Tụt FPS, 📸 Copy Ảnh Chụp Kèm Khung, ☁️ Sao Lưu Phím Tắt & Server, 🚀 Nạp Chunk Đa Nhân)",
  "homepage": "https://buiduchuy2010qn-prog.github.io/blockway-launcher/",
  "repository": {
    "type": "git",
    "url": "https://github.com/buiduchuy2010qn-prog/blockway-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/buiduchuy2010qn-prog/blockway-launcher/issues"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never"
  },
  "keywords": [
    "blockway-launcher",
    "blockway",
    "aether-mine-launcher",
    "aether-craft-launcher",
    "buiduchuy2010qn-prog",
    "minecraft",
    "minecraft-launcher",
    "minecraft-launcher-vietnam",
    "launcher",
    "modrinth",
    "fabric",
    "forge",
    "quilt",
    "neoforge",
    "skinview3d",
    "electron-launcher"
  ],
  "author": "buiduchuy2010qn-prog",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.4.16",
    "minecraft-launcher-core": "^3.16.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.buiduchuy.aethercraft",
    "productName": "BlockWay Launcher",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "ota-manifest.json",
      "LICENSE.rtf"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/ui/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "unicode": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.rtf",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlockWay Launcher",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "src/ui/app-logo.png",
      "category": "Game",
      "maintainer": "buiduchuy2010qn-prog <buiduchuy2010qn-prog@users.noreply.github.com>",
      "synopsis": "BlockWay Launcher PRO — Every World, One Place",
      "artifactName": "${productName}-Linux-${version}.${ext}"
    }
  }
}
